{
  "name": "@caplatform/mailhub-ui",
  "version": "0.1.0",
  "private": false,
  "description": "Provider-neutral, metadata-first MailHub React workspace.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "devDependencies": {
    "@types/react": ">=18",
    "typescript": ">=5.7"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "license": "UNLICENSED"
}
