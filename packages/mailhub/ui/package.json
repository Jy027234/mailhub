{
  "name": "@fyjtech/mailhub-ui",
  "version": "0.1.0",
  "private": false,
  "description": "Provider-neutral, metadata-first MailHub React workspace.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.test.json",
    "check:locales": "node scripts/check-locales.mjs",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "build": "tsc -p tsconfig.json && node scripts/check-locales.mjs"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./standalone": {
      "types": "./dist/standalone.d.ts",
      "import": "./dist/standalone.js"
    },
    "./styles.css": "./src/styles.css"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": ">=18",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "axe-core": "^4.13.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "react-dom": "^19.3.0",
    "typescript": ">=5.7",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "license": "UNLICENSED"
}
