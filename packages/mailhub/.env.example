# Development is sandbox/read-only. Production requires every control below
# and an explicitly injected PostgreSQL/object-store/host adapter graph.
MAILHUB_ENV=development
MAILHUB_DATABASE_URL=postgresql+asyncpg://mailhub:change-me@127.0.0.1:5432/mailhub
MAILHUB_OBJECT_STORE_ENDPOINT=
MAILHUB_KMS_KEY_REF=
MAILHUB_AV_SCANNER_ENDPOINT=
MAILHUB_DLP_ENDPOINT=
MAILHUB_CREDENTIAL_BROKER_ENDPOINT=
# Bearer token used only for MailHub -> CAPlatform Host Port calls. The same
# value is injected into the BFF; Provider client secrets remain BFF-only.
MAILHUB_HOST_SERVICE_TOKEN=
MAILHUB_HOST_IDENTITY_ENDPOINT=
MAILHUB_APPROVAL_ENDPOINT=
MAILHUB_AI_EXECUTION_ENDPOINT=
MAILHUB_HOST_ACTION_ENDPOINT=
MAILHUB_KNOWLEDGE_ENDPOINT=
MAILHUB_AGENT_MEMORY_ENDPOINT=
MAILHUB_TELEMETRY_ENDPOINT=
MAILHUB_QUOTA_ENDPOINT=
# Required only when a real-provider *_PUSH_ENABLED flag is true; HTTPS (or
# loopback HTTP for local development), without credentials/query/fragment.
MAILHUB_PROVIDER_SUBSCRIPTION_ENDPOINT=
MAILHUB_PROVIDER_NOTIFICATION_VERIFIER_ENDPOINT=
MAILHUB_KILL_SWITCH_ENDPOINT=
MAILHUB_EVENT_PUBLISHER_ENDPOINT=
# Versioned, bounded AI policy. Values are validated at startup; body text is
# never emitted as telemetry or budget evidence.
MAILHUB_AI_POLICY_VERSION=mail-ai-policy-v1
MAILHUB_AI_PROMPT_VERSION=rules-prompt-v1
MAILHUB_AI_PARSER_VERSION=rules-parser-v1
MAILHUB_AI_CALIBRATION_VERSION=evidence-calibration-v1
MAILHUB_AI_MODE=rules
MAILHUB_AI_MAX_INPUT_CHARS=200000
MAILHUB_AI_MAX_EVIDENCE=100
MAILHUB_AI_MAX_ACTIONS=20
MAILHUB_AI_MAX_ESTIMATED_TOKENS=50000
MAILHUB_AI_CHARS_PER_TOKEN=4.0
MAILHUB_AI_ACTION_MIN_CONFIDENCE=0.65
MAILHUB_AI_KNOWLEDGE_MIN_CONFIDENCE=0.75
MAILHUB_AI_LOW_CONFIDENCE_FLOOR=0.35
MAILHUB_OUTBOUND_ENABLED=false
MAILHUB_JOB_LEASE_SECONDS=300
MAILHUB_ALLOW_SANDBOX=true
# M2/M3 controlled activation switches. Keep disabled until the provider
# preflight, host OAuth boundary and isolated-mailbox evidence are complete.
MAILHUB_GMAIL_ENABLED=false
MAILHUB_MICROSOFT_GRAPH_ENABLED=false
# Read-only is a hard safety gate for the initial real-provider wave.
MAILHUB_GMAIL_READ_ONLY=true
MAILHUB_MICROSOFT_GRAPH_READ_ONLY=true
# Push/subscription is an explicit Host-boundary capability; keep false until
# the Host endpoints and real watch/change-notification/renewal evidence exist.
MAILHUB_GMAIL_PUSH_ENABLED=false
MAILHUB_MICROSOFT_GRAPH_PUSH_ENABLED=false

# OAuth preflight values. Client IDs and endpoints are non-secret metadata;
# client secrets, authorization codes and refresh tokens remain in the host
# Credential Broker. The signing secret must be injected by a secret manager.
MAILHUB_OAUTH_STATE_SIGNING_SECRET=
MAILHUB_GMAIL_CLIENT_ID=
MAILHUB_GMAIL_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
MAILHUB_GMAIL_REDIRECT_URI=https://app.example.test/mail/oauth/gmail/callback
MAILHUB_GMAIL_REDIRECT_URIS=https://app.example.test/mail/oauth/gmail/callback
MAILHUB_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
MAILHUB_GRAPH_CLIENT_ID=
MAILHUB_GRAPH_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MAILHUB_GRAPH_AUTHORITY_TENANT=common
MAILHUB_GRAPH_REDIRECT_URI=https://app.example.test/mail/oauth/microsoft_graph/callback
MAILHUB_GRAPH_REDIRECT_URIS=https://app.example.test/mail/oauth/microsoft_graph/callback
MAILHUB_GRAPH_SCOPES=openid profile email offline_access User.Read Mail.Read
# M2/M3 preflight rejects Gmail write scopes (gmail.send/modify/compose/insert)
# and Graph Mail.Send/Mail.ReadWrite/Mail.Manage even when read_only=true.
# CAPlatform Beta requires a tenant-specific Entra UUID; `common` remains a
# fail-closed placeholder until an isolated tenant is configured.

# Provider activation preflight (never prints values or makes network calls):
# python scripts/provider_preflight.py --provider all --json

# Optional A2 real-observation runner. These values identify an already
# authorized MailHub deployment and isolated connection; do not put provider
# access/refresh tokens here. The runner additionally requires
# MAILHUB_ACTIVATION_ALLOW_NETWORK=true and --confirm-real-provider.
MAILHUB_ACTIVATION_API_URL=
MAILHUB_ACTIVATION_ENV=test
MAILHUB_ACTIVATION_TENANT_ID=
MAILHUB_ACTIVATION_SUBJECT_ID=
MAILHUB_ACTIVATION_CONNECTION_ID=
MAILHUB_ACTIVATION_EVIDENCE_ROOT=provider-activation
# MAILHUB_ACTIVATION_AUTHORIZATION=  # optional host request header; never logged
MAILHUB_ACTIVATION_ALLOW_NETWORK=false

# Optional IMAP/SMTP connector. SMTP is fail-closed unless this is true.
MAILHUB_IMAP_HOST=
MAILHUB_SMTP_HOST=
MAILHUB_SMTP_SEND_ENABLED=false
