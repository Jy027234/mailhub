# MailHub B4 本地激活环境 —— 共享环境文件（local-host 与 mailhub-api 共用）
# 复制为 .env 并填入真实值；.env 已被 .gitignore 排除，绝不提交。

# ---------- 共享服务令牌（MailHub → 宿主调用认证，>=32 可打印字符） ----------
# 生成: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAILHUB_HOST_SERVICE_TOKEN=replace-with-secrets.token_urlsafe(32)

# ---------- local-host 宿主配置 ----------
# Fernet 加密密钥派生源（>=32 字符），用于 OAuth state/凭据/对象存储加密
HOST_ENCRYPTION_SECRET=replace-with-another-32+char-secret
HOST_DATABASE_PATH=./data/local_host.db
HOST_MAILHUB_API_URL=http://127.0.0.1:8000

# Google OAuth 客户端（仅宿主持有 secret；MailHub 进程永不注入 secret）
HOST_GMAIL_ENABLED=false
HOST_GMAIL_CLIENT_ID=
HOST_GMAIL_CLIENT_SECRET=
HOST_GMAIL_REDIRECT_URI=http://127.0.0.1:8090/oauth/gmail/callback
HOST_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ---------- MailHub durable 运行时配置 ----------
MAILHUB_ENV=production
MAILHUB_DATABASE_URL=postgresql+asyncpg://mailhub:mailhub@127.0.0.1:5433/mailhub
MAILHUB_ALLOW_SANDBOX=false
MAILHUB_KMS_KEY_REF=local-fernet-key

# OAuth state 签名密钥（>=32 字符），与 HOST_ENCRYPTION_SECRET 不得相同
MAILHUB_OAUTH_STATE_SIGNING_SECRET=replace-with-a-third-32+char-secret

# Gmail 注册信息 —— 必须与 HOST_GMAIL_* 保持一致
MAILHUB_GMAIL_ENABLED=false
MAILHUB_GMAIL_READ_ONLY=true
MAILHUB_GMAIL_CLIENT_ID=
MAILHUB_GMAIL_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
MAILHUB_GMAIL_REDIRECT_URI=http://127.0.0.1:8090/oauth/gmail/callback
MAILHUB_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# ---------- IMAP/SMTP 应用密码路径（B4 免 OAuth 切片） ----------
# 隔离 Gmail 账号打开两步验证后生成应用密码；SMTP 发送保持关闭。
MAILHUB_IMAP_ENABLED=false
MAILHUB_IMAP_HOST=imap.gmail.com
MAILHUB_SMTP_HOST=smtp.gmail.com
MAILHUB_IMAP_PORT=993
MAILHUB_SMTP_PORT=465
MAILHUB_IMAP_FOLDER=INBOX
MAILHUB_OUTBOUND_ENABLED=false
MAILHUB_SMTP_SEND_ENABLED=false
MAILHUB_KILL_SWITCH_ENDPOINT=http://127.0.0.1:8090
# 走查时用（也可交互输入）：HOST_IMAP_USERNAME / HOST_IMAP_APP_PASSWORD

# Host Port 端点（全部指向 local-host）
MAILHUB_CREDENTIAL_BROKER_ENDPOINT=http://127.0.0.1:8090
MAILHUB_HOST_IDENTITY_ENDPOINT=http://127.0.0.1:8090
MAILHUB_APPROVAL_ENDPOINT=http://127.0.0.1:8090
MAILHUB_HOST_ACTION_ENDPOINT=http://127.0.0.1:8090
MAILHUB_KNOWLEDGE_ENDPOINT=http://127.0.0.1:8090
MAILHUB_OBJECT_STORE_ENDPOINT=http://127.0.0.1:8090
MAILHUB_AI_EXECUTION_ENDPOINT=http://127.0.0.1:8090
MAILHUB_TELEMETRY_ENDPOINT=http://127.0.0.1:8090
MAILHUB_EVENT_PUBLISHER_ENDPOINT=http://127.0.0.1:8090
MAILHUB_QUOTA_ENDPOINT=http://127.0.0.1:8090
MAILHUB_AV_SCANNER_ENDPOINT=http://127.0.0.1:8090
MAILHUB_DLP_ENDPOINT=http://127.0.0.1:8090
# ---------- AI 模型网关（OpenAI 兼容；缺省时分析走确定性规则直通） ----------
# 正文会发送到该端点（宿主数据出境决策）；网关失败自动回退规则，不阻塞分析
HOST_AI_GATEWAY_URL=
HOST_AI_GATEWAY_MODEL=
HOST_AI_GATEWAY_API_KEY=

