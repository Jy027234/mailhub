CAPLATFORM_ENVIRONMENT=development
CAPLATFORM_AI_MODE=fixture
CAPLATFORM_PRODUCT_ID=civil_aviation_workbench
CAPLATFORM_WEB_ORIGINS=http://127.0.0.1:5180,http://localhost:5180

PLATFORM_CORE_BASE_URL=http://127.0.0.1:8010
PLATFORM_CORE_PUBLIC_BASE_URL=http://127.0.0.1:8010
PLATFORM_CONNECTION_ID=
PLATFORM_SERVICE_TOKEN=
AGENTCTL_BASE_URL=http://127.0.0.1:8765
MCP_INTEGRATION_BASE_URL=
MCP_INTEGRATION_SERVICE_TOKEN=
MCP_INTEGRATION_TIMEOUT_SECONDS=10
AIPROJECTOPS_BASE_URL=http://127.0.0.1:8001
MAILHUB_BASE_URL=http://127.0.0.1:8090
MAILHUB_TIMEOUT_SECONDS=15
# Shared only between MailHub and the BFF Host Port. Generate an independent
# random value; never reuse the browser session or Provider client secret.
MAILHUB_HOST_SERVICE_TOKEN=
# BFF-only encryption key for the local/Beta credential adapter. Production
# replaces the SQLite adapter with an approved Secret Manager/KMS backend.
MAILHUB_CREDENTIAL_ENCRYPTION_SECRET=
# OAuth registration and client secrets are host-owned. Keep disabled until
# the MailHub provider preflight and isolated mailbox evidence exists.
MAILHUB_GMAIL_ENABLED=false
MAILHUB_GMAIL_CLIENT_ID=
MAILHUB_GMAIL_CLIENT_SECRET=
MAILHUB_GMAIL_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
MAILHUB_GMAIL_REDIRECT_URI=http://127.0.0.1:5180/mail/oauth/gmail/callback
MAILHUB_GMAIL_REDIRECT_URIS=http://127.0.0.1:5180/mail/oauth/gmail/callback
MAILHUB_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
MAILHUB_MICROSOFT_GRAPH_ENABLED=false
MAILHUB_GRAPH_CLIENT_ID=
MAILHUB_GRAPH_CLIENT_SECRET=
MAILHUB_GRAPH_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MAILHUB_GRAPH_AUTHORITY_TENANT=common
MAILHUB_GRAPH_REDIRECT_URI=http://127.0.0.1:5180/mail/oauth/microsoft_graph/callback
MAILHUB_GRAPH_REDIRECT_URIS=http://127.0.0.1:5180/mail/oauth/microsoft_graph/callback
MAILHUB_GRAPH_SCOPES=openid,profile,email,offline_access,User.Read,Mail.Read
# BFF readiness rejects Gmail write scopes and Graph Mail.Send/Mail.ReadWrite/
# Mail.Manage/Mail.FullAccessAsUser; read_only is enforced together with scope.
# CAPlatform Beta additionally requires a tenant-specific Entra UUID; `common`
# is documentation-only and deliberately fails the real Broker activation gate.
DATA_STRUCTURING_TOOLHOST_BASE_URL=http://127.0.0.1:8787
CAPLATFORM_TOOL_PACKAGE_RELEASE_DIR=../../deployment/tool_packages/release

CAPLATFORM_SESSION_COOKIE=caplatform_session
CAPLATFORM_SESSION_TTL_SECONDS=3600
CAPLATFORM_SESSION_COOKIE_SECURE=false
CAPLATFORM_SESSION_ENCRYPTION_SECRET=replace-with-random-session-encryption-secret-at-least-32-characters
# Comma-separated decrypt-only keys used for one startup rotation. Remove
# after all persisted records have been re-encrypted by a successful startup.
CAPLATFORM_SESSION_ENCRYPTION_SECRET_PREVIOUS=
