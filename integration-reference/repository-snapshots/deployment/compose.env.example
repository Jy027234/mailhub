POSTGRES_USER=zhiziagent
POSTGRES_PASSWORD=replace-with-random-password-at-least-32-characters
MINIO_ROOT_USER=caplatform
MINIO_ROOT_PASSWORD=replace-with-random-password-at-least-32-characters
ZAP_JWT_SECRET=replace-with-random-jwt-secret-at-least-32-characters
ZAP_AGENTCTL_ADMIN_TOKEN=replace-with-random-agentctl-admin-token
ZAP_AGENTCTL_ENTITLEMENT_SYNC_HMAC_SECRET=replace-with-random-entitlement-secret-at-least-32-characters
ZAP_PLATFORM_TOOL_CONTEXT_SECRET=replace-with-independent-tool-context-secret-at-least-32-characters
ZAP_BOOTSTRAP_ADMIN_TOKEN=replace-with-random-one-time-bootstrap-token
ZAP_PUBLIC_REGISTRATION_TENANT_SLUG=caplatform
CAPLATFORM_SESSION_ENCRYPTION_SECRET=replace-with-random-session-encryption-secret-at-least-32-characters
CAPLATFORM_SESSION_ENCRYPTION_SECRET_PREVIOUS=
CAPLATFORM_PROJECT_TASK_PROPOSAL_TTL_SECONDS=86400
CAPLATFORM_ACTIVE_TOOL_PACKAGE_IDS=ai-opportunity-scan
PLATFORM_CONNECTION_ID=replace-after-platform-onboarding
CAPLATFORM_TENANT_ID=replace-after-platform-onboarding
AGENTCTL_PLATFORM_INSTRUCTION_SKILLS_TOKEN=replace-with-dedicated-agentctl-instruction-skill-reader-token
AGENTCTL_PLATFORM_TOOL_BINDINGS_TOKEN=replace-with-dedicated-agentctl-binding-reader-token
CAPLATFORM_LITE_VALUATION_HANDLER_TOKEN=replace-with-random-lite-valuation-handler-token-at-least-32-characters
CAPLATFORM_MODEL_API_KEY=replace-via-windows-dpapi-provisioning
CAPLATFORM_MODEL_BASE_URL=https://provider.example/v1
PLATFORM_SERVICE_TOKEN=replace-with-platform-issued-service-token
WEB_PORT=8088
CAPLATFORM_WEB_ORIGINS=http://localhost:8088,http://localhost:5180,http://localhost:5182
# MailHub OAuth registration metadata; leave disabled until provider activation
# evidence is present.  Secrets and refresh tokens stay in the Credential Broker.
MAILHUB_GMAIL_ENABLED=false
MAILHUB_GMAIL_CLIENT_ID=
MAILHUB_GMAIL_CLIENT_SECRET=
MAILHUB_GMAIL_AUTHORIZATION_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
MAILHUB_GMAIL_REDIRECT_URI=http://localhost:5180/mail/oauth/gmail/callback
MAILHUB_GMAIL_REDIRECT_URIS=http://localhost:5180/mail/oauth/gmail/callback
MAILHUB_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly
MAILHUB_MICROSOFT_GRAPH_ENABLED=false
MAILHUB_GRAPH_CLIENT_ID=
MAILHUB_GRAPH_CLIENT_SECRET=
MAILHUB_GRAPH_AUTHORIZATION_ENDPOINT=https://login.microsoftonline.com/common/oauth2/v2.0/authorize
MAILHUB_GRAPH_AUTHORITY_TENANT=common
MAILHUB_GRAPH_REDIRECT_URI=http://localhost:5180/mail/oauth/microsoft_graph/callback
MAILHUB_GRAPH_REDIRECT_URIS=http://localhost:5180/mail/oauth/microsoft_graph/callback
MAILHUB_GRAPH_SCOPES=openid,profile,email,offline_access,User.Read,Mail.Read
MAILHUB_HOST_SERVICE_TOKEN=
MAILHUB_CREDENTIAL_ENCRYPTION_SECRET=
PLATFORM_CORE_PORT=8010
PLATFORM_CORE_PUBLIC_BASE_URL=http://localhost:8010
AGENTCTL_PORT=8766
PIP_INDEX_URL=https://pypi.org/simple
PIP_DEFAULT_TIMEOUT=100
PLATFORM_CORE_CONTEXT=../../zhiziagent-platform-core
PARSECORE_CONTEXT=../../JXZTtool
PARSECORE_API_KEY=replace-with-random-internal-parsecore-api-key-at-least-32-characters
# May reuse PARSECORE_API_KEY in test environments; use a distinct key when
# the staged-upload bridge is exposed beyond the private compose network.
PARSECORE_UPLOAD_BRIDGE_API_KEY=replace-with-random-internal-parsecore-upload-key-at-least-32-characters
PARSECORE_IMAGE=zhiziagent-parsecore:caplatform-pilot
AGENTCTL_CONTEXT=../../Agent
AGENTCTL_RELEASE_CONTEXT=../../Agent/.artifacts/managed-memory-growth/dist
# Release evidence must replace these values with full 40-character Git revisions
# and use immutable image tags. `unknown` is acceptable only for local development.
CAPLATFORM_VCS_REF=unknown
PLATFORM_CORE_VCS_REF=unknown
AGENTCTL_VCS_REF=unknown
PLATFORM_CORE_IMAGE=zhiziagent-platform-core:caplatform-pilot
AGENTCTL_IMAGE=agentctl:caplatform-pilot
# AIProjectOPS can be built from an independently cloned checkout when the
# external-products profile is enabled.
AIPROJECTOPS_CONTEXT=../../AIProjectOPS
AIPROJECTOPS_DB_PASSWORD=replace-with-random-aiprojectops-db-password-at-least-32-characters
AIPROJECTOPS_IMAGE=aiprojectops:local
AIPROJECTOPS_PLATFORM_SERVICE_TOKEN=
AIPROJECTOPS_WRITE_TIMEOUT_SECONDS=8
CAPLATFORM_PRODUCT_EVENT_TOKEN=replace-with-random-project-event-token-at-least-32-characters
# Dedicated AgentCTL service identity: scopes model_gateway.complete +
# ca.project.write, constrained to product operation ca.project.generate_plan.
AIPROJECTOPS_AGENTCTL_SERVICE_TOKEN=replace-with-dedicated-project-planner-token
PROJECT_PLANNING_WORKER_ID=caplatform-project-planner
PROJECT_PLANNING_POLL_SECONDS=3
PROJECT_PLANNING_BATCH_SIZE=3
PROJECT_PLANNER_MODEL_HINT=
PROJECT_PLANNER_TIMEOUT_SECONDS=120
# EDM remains an explicit open gate until its real image and identity contract exist.
EDM_IMAGE=enterprise-document-management:local
TOOLHOST_IMAGE=caplatform-governed-toolhost:local
TOOLKIT_RELEASE_CONTEXT=../.tmp/toolkit-build-context
TOOLHOST_PLATFORM_SERVICE_TOKEN=replace-with-dedicated-toolhost-service-token
TOOLHOST_PORT=8787
LITE_VALUATION_TOOLHOST_IMAGE=caplatform-lite-valuation-toolhost:local
LITE_VALUATION_TOOLHOST_PORT=8790
